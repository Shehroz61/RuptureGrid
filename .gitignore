# RuptureGrid v1.0 — .gitignore
# Phase 0: documentation only. Entries are forward-looking for later phases;
# nothing here implies those artifacts exist yet.

# Freebuff/Codebuff client-local tooling state
.freebuff/

# Dependencies
node_modules/
.pnpm-store/

# Builds & output
dist/
build/
next/
.next/
out/
.turbo/
*.tsbuildinfo
# Generated by Next.js tooling:
next-env.d.ts

# Prisma generated clients (regenerated via pnpm db:generate)
packages/control-db/src/generated/
packages/demo-db/src/generated/

# Environment & secrets — never commit real values
.env
.env.*
!.env.example

# Databases (local volumes, never source of truth)
*.sqlite
*.db
pgdata/
data/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Test artifacts
coverage/
test-results/
playwright-report/
blob-report/

# Phase 8 showcase generated artifacts (screenshots, video, session
# manifests, browser profiles) — generated per-run, never committed.
.artifacts/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
