{
  "name": "@rupturegrid/engine",
  "version": "1.0.0",
  "private": true,
  "description": "RuptureGrid Phase 3 execution engine: validation, snapshots, durable run/step state, claims/leases/fencing, HTTP executor, reconciliation",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@rupturegrid/config": "workspace:*",
    "@rupturegrid/control-db": "workspace:*",
    "@rupturegrid/logger": "workspace:*",
    "@rupturegrid/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  }
}
