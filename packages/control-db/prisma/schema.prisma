// =====================================================================
// RuptureGrid Control PostgreSQL schema
// =====================================================================
// Migration 0001 established the schema ownership boundaries
// (control / evidence / analysis). Migration 0002 added the Phase 3
// execution-engine domain models (architecture §6):
//
//   TargetRegistration / TargetOrigin — registered, authorized targets
//   ExperimentDefinition / ExperimentRevision — versioned definitions
//   RunSnapshot — canonicalized, hash-pinned execution intent (ADR-0010)
//   ExperimentRun / ExperimentStepRun — durable state machines (§7, §8)
//   StepInvocation — one physical attempt of one step (§6)
//   StaleWriterEvent — record of rejected stale-writer writes (§10)
//
// Migration 0003 (this schema, Phase 4) adds the evidence-truth models
// (docs/evidence-model.md, ADR-0006):
//
//   evidence schema:  RawObservation, NormalizedEvent,
//                     CausalRelationship, EvidenceIntegrityHead
//   analysis schema:  InvariantDefinition, EvaluationBatch,
//                     InvariantEvaluation
//
// Migration 0004 (Phase 5) adds the forensic-analysis models to the
// analysis context (docs/evidence-model.md §8/§9, docs/phase-roadmap.md
// Phase 5):
//
//   analysis schema:  Finding, FindingEvidenceReference,
//                     ForensicTimelineEntry, ForensicDerivation,
//                     ReproductionDefinition, RunComparison
//
// Still deliberately ABSENT (R-01 phase boundaries): finding severity,
// finding workflow status (OPEN/ACKNOWLEDGED/...), AI interpretation
// tables, product UI.
//
// Phase 3 execution tables stay in `control` (§13: execution state and
// evidence are different concepts); RawObservation/NormalizedEvent/
// CausalRelationship live in `evidence`; invariant models live in
// `analysis`. No evidence tables exist in Demo PostgreSQL (ADR-0002).
generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  schemas  = ["control", "evidence", "analysis"]
}

// ---------------------------------------------------------------------
// Enums (canonical terminology — AGENTS R-18, architecture §7/§8)
// ---------------------------------------------------------------------

/// security-boundaries §2: `local-development | staging | production`.
/// Production fault targeting is DENIED in v1 (ADR-0011).
enum TargetEnvironment {
  LOCAL_DEVELOPMENT
  STAGING
  PRODUCTION

  @@schema("control")
}

/// Run state machine (architecture §8).
enum RunState {
  CREATED
  SNAPSHOT_PINNED
  DISPATCHING
  RUNNING
  RECONCILING
  COMPLETED
  FAILED
  CANCELLED

  @@schema("control")
}

/// Step intent-execution state machine (architecture §8). The v1
/// ordered-dependency policy stops a run on process failure: a step
/// whose prerequisite terminally FAILED/CANCELLED is itself CANCELLED
/// (sideEffectKnowledge KNOWN_ABSENT), never invented as a new state.
enum StepState {
  PENDING
  DISPATCHED
  CLAIMED
  EXECUTING
  SUCCEEDED
  FAILED
  CANCELLED

  @@schema("control")
}

/// intentOutcome — did the executor complete its own work? (§7.1)
enum IntentOutcome {
  SUCCEEDED
  FAILED
  CANCELLED

  @@schema("control")
}

/// sideEffectKnowledge — what is known about the remote mutation?
/// (§7.1, ADR-0008). Orthogonal to intentOutcome; never collapsed.
enum SideEffectKnowledge {
  KNOWN_OCCURRED
  KNOWN_ABSENT
  INDETERMINATE
  NOT_APPLICABLE

  @@schema("control")
}

/// Durable dispatch marker on a step run (ADR-0003 §9): PostgreSQL
/// records the intent; BullMQ is coordination only. RECONCILE marks a
/// step the reconciler has taken under recovery responsibility.
enum DispatchState {
  PENDING
  DISPATCHED
  RECONCILE

  @@schema("control")
}

/// Experiment-declared retry classification (§7.2). NONE = executor
/// never retries; SAFE = retry permitted for provably pre-send
/// failures and read-only transient failures within a bounded budget.
/// INDETERMINATE mutating outcomes are never retried regardless
/// (ADR-0008).
enum DeclaredRetryPolicy {
  NONE
  SAFE

  @@schema("control")
}

/// Declared mutation semantics of an action (§7.1): read-only actions
/// carry sideEffectKnowledge NOT_APPLICABLE; mutating actions get a
/// real sideEffectKnowledge classification per invocation.
enum MutationClassification {
  READ_ONLY
  MUTATING

  @@schema("control")
}

/// §27 contract kinds: what the target contract lets the executor
/// conclude about side effects from responses. demo-fintech-webhook
/// guarantees no-effect for its definitive 4xx transport rejections.
enum ContractKind {
  DEMO_FINTECH_WEBHOOK
  GENERIC_HTTP

  @@schema("control")
}

/// Furthest transport stage an invocation reached (§7.1 classification
/// input). REQUEST_SENT or beyond ⇒ the request may have reached the
/// target; below it ⇒ provably not sent (KNOWN_ABSENT territory).
enum TransportStage {
  PREPARED
  CONNECTING
  REQUEST_SENT
  RESPONSE_HEADERS
  RESPONSE_COMPLETE

  @@schema("control")
}

// ---------------------------------------------------------------------
// Target registration (security-boundaries §2)
// ---------------------------------------------------------------------

/// A registered, authorized target. Executable origins, environment
/// classification, and the credential REFERENCE NAMES its experiments
/// may use. Never stores secret values (ADR-0012).
model TargetRegistration {
  id             String            @id @default(uuid()) @db.Uuid
  displayName    String            @unique @db.VarChar(120)
  environment    TargetEnvironment  /// Credential reference names steps on this target may declare.
  /// Must be a subset of the executor's server-side allowlist
  /// (EXECUTOR_CREDENTIAL_REFS); enforced at registration.
  credentialRefs String[]
  /// Response-interpretation contract used by side-effect
  /// classification (architecture §7.1, prompt §27).
  contractKind ContractKind
  createdAt    DateTime          @default(now()) @db.Timestamptz(6)

  origins   TargetOrigin[]
  revisions ExperimentRevision[]

  @@map("target_registration")
  @@schema("control")
}

/// One normalized executable origin (scheme + host + port) of a
/// target. Stored pre-normalized (lowercase host, explicit port);
/// the executor compares parsed-and-normalized origins, never strings
/// (security-boundaries §3). Globally unique so origin authority is
/// never ambiguous.
model TargetOrigin {
  id       String @id @default(uuid()) @db.Uuid
  targetId String @db.Uuid
  /// Canonical form: `<scheme>://<host>[:<port>]` with lowercase host.
  origin   String @unique @db.VarChar(255)

  target TargetRegistration @relation(fields: [targetId], references: [id], onDelete: Restrict)

  @@index([targetId])
  @@map("target_origin")
  @@schema("control")
}

// ---------------------------------------------------------------------
// Experiment definitions and immutable revisions
// ---------------------------------------------------------------------

model ExperimentDefinition {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(120)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  revisions ExperimentRevision[]

  @@map("experiment_definition")
  @@schema("control")
}

/// One immutable version of an experiment: target binding + validated,
/// normalized ordered steps. Never updated after creation (ADR-0010:
/// runs execute from snapshots, and snapshots pin a revision).
model ExperimentRevision {
  id             String   @id @default(uuid()) @db.Uuid
  definitionId   String   @db.Uuid
  revisionNumber Int
  targetId       String   @db.Uuid
  /// Validated normalized step templates (the ExperimentDocument
  /// shape from @rupturegrid/engine — validation happens before any
  /// write; secrets are never present).
  stepsJson      Json
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  definition ExperimentDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  target     TargetRegistration   @relation(fields: [targetId], references: [id], onDelete: Restrict)
  snapshots  RunSnapshot[]

  @@unique([definitionId, revisionNumber])
  @@index([targetId])
  @@map("experiment_revision")
  @@schema("control")
}

// ---------------------------------------------------------------------
// Run snapshots (ADR-0010)
// ---------------------------------------------------------------------

/// Canonicalized, content-hashed, append-only materialization of
/// everything one run needs. Created BEFORE dispatch/execution; runs
/// reference the snapshot, never the mutable definition rows.
model RunSnapshot {
  id               String   @id @default(uuid()) @db.Uuid
  revisionId       String   @db.Uuid
  /// Canonicalization algorithm version (documented constant).
  canonicalization String   @db.VarChar(32)
  /// SHA-256 hex of the canonical UTF-8 bytes of `content`.
  contentHash      String   @unique @db.VarChar(64)
  /// The full snapshot document (deterministically serialized).
  content          Json
  createdAt        DateTime @default(now()) @db.Timestamptz(6)

  revision ExperimentRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  runs     ExperimentRun[]
  reproductionDefinitions ReproductionDefinition[]

  @@index([revisionId])
  @@map("run_snapshot")
  @@schema("control")
}

// ---------------------------------------------------------------------
// Runs and step runs (architecture §7–§10)
// ---------------------------------------------------------------------

model ExperimentRun {
  id            String    @id @default(uuid()) @db.Uuid
  snapshotId    String    @db.Uuid
  state         RunState
  /// Bounded terminal failure detail (FAILED runs). Never contains
  /// secrets (redaction before persistence).
  failureReason String?   @db.VarChar(500)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  terminalAt    DateTime? @db.Timestamptz(6)
  /// Set by the API cancel endpoint; workers observe it at
  /// cooperative cancel points (before dispatch, between waves,
  /// before each retry) — never a mid-request abort (§8 §10).
  cancelRequestedAt DateTime? @db.Timestamptz(6)

  snapshot RunSnapshot        @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  steps    ExperimentStepRun[]
  rawObservations      RawObservation[]
  normalizedEvents     NormalizedEvent[]
  causalRelationships  CausalRelationship[]
  evidenceIntegrityHead EvidenceIntegrityHead?
  evaluationBatches    EvaluationBatch[]
  invariantEvaluations InvariantEvaluation[]
  findings             Finding[]
  timelineEntries      ForensicTimelineEntry[]
  forensicDerivations  ForensicDerivation[]
  reproductionDefinitions ReproductionDefinition[]

  @@index([state])
  @@index([createdAt])
  @@map("experiment_run")
  @@schema("control")
}

model ExperimentStepRun {
  id       String @id @default(uuid()) @db.Uuid
  runId    String @db.Uuid
  /// 0-based position in the snapshot's ordered step list.
  sequence Int
  name     String @db.VarChar(120)

  state StepState @default(PENDING)

  // ---- Durable ownership (ADR-0009): lease fields ON the step run ----
  /// Worker identity of the current/last claim generation.
  leaseOwnerId   String?   @db.VarChar(120)
  /// Lease deadline; claims and expiries are decided against
  /// PostgreSQL time (statement_now), not worker clocks.
  leaseExpiresAt DateTime? @db.Timestamptz(6)
  /// Monotonic claim generation; incremented by every successful
  /// claim. All owner state writes are conditioned on it.
  fencingToken   BigInt    @default(0)

  // ---- Durable dispatch intent (ADR-0003) ----
  dispatchState     DispatchState @default(PENDING)
  dispatchAttempts  Int           @default(0)
  lastDispatchError String?       @db.VarChar(500)
  dispatchedAt      DateTime?     @db.Timestamptz(6)

  // ---- Outcome dimensions (§7.1, orthogonal) ----
  intentOutcome       IntentOutcome?
  sideEffectKnowledge SideEffectKnowledge?
  /// Executor retry attempts consumed (repeat invocations are
  /// separate StepInvocation rows, not retries).
  attemptCount        Int                  @default(0)
  /// Bounded terminal error detail. Never contains secrets.
  error               String?              @db.VarChar(500)

  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  claimedAt   DateTime? @db.Timestamptz(6)
  executingAt DateTime? @db.Timestamptz(6)
  terminalAt  DateTime? @db.Timestamptz(6)

  run               ExperimentRun      @relation(fields: [runId], references: [id], onDelete: Restrict)
  invocations       StepInvocation[]
  staleWriterEvents StaleWriterEvent[]
  rawObservations   RawObservation[]

  @@unique([runId, sequence])
  @@index([runId])
  /// Reconciliation discovery: dispatchable or reclaimable steps.
  @@index([dispatchState, state])
  /// Lease-expiry discovery: CLAIMED/EXECUTING past their deadline.
  @@index([state, leaseExpiresAt])
  @@map("experiment_step_run")
  @@schema("control")
}

/// One physical attempt of one step, including deliberate repeats
/// (§7.2: repeat ≠ retry). Carries the per-invocation identity used
/// for evidence correlation (e.g. the Demo's deliveryAttemptId) and
/// the transport-stage detail that drives side-effect classification.
model StepInvocation {
  id                 String  @id @default(uuid()) @db.Uuid
  stepRunId          String  @db.Uuid
  /// 1-based physical invocation index within the step (repeat).
  sequence           Int
  /// Target-facing per-invocation identity when the action declares
  /// one (e.g. x-rupturegrid-delivery-attempt-id). Generated per
  /// physical invocation; never reused.
  invocationIdentity String? @db.VarChar(120)

  /// Furthest transport stage reached (NULL = never started).
  transportStage TransportStage?
  httpStatus     Int?
  requestBytes   Int?
  responseBytes  Int?
  /// Bounded captured response body for legitimate variable-reference
  /// steps. Subject to redaction; capped by the response-size limit.
  responseBody   String?
  /// 1-based index of the repeat wave; ordered so later steps can
  /// reference a specific delivery deterministically.
  waveIndex      Int?
  /// Executor-side timing for the invocation (ms). Observation only —
  /// never authoritative for ownership decisions.
  durationMs            Int?
  outcome               IntentOutcome?
  sideEffectKnowledge   SideEffectKnowledge?
  /// Bounded per-invocation error detail. Never contains secrets.
  error                 String?              @db.VarChar(500)
  /// Owner + fencing token of the writer generation (architecture
  /// §10: records are attributed to their invocation and writer).
  writtenByOwner        String?              @db.VarChar(120)
  writtenByFencingToken BigInt?

  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  finishedAt DateTime? @db.Timestamptz(6)

  stepRun ExperimentStepRun @relation(fields: [stepRunId], references: [id], onDelete: Restrict)

  @@unique([stepRunId, sequence])
  @@map("step_invocation")
  @@schema("control")
}

/// Append-only record of a rejected stale-writer state write
/// (architecture §10). Fencing governs durable state; the attempt is
/// recorded, never silently discarded.
model StaleWriterEvent {
  id           String   @id @default(uuid()) @db.Uuid
  stepRunId    String   @db.Uuid
  /// Owner that attempted the write.
  attemptedBy  String   @db.VarChar(120)
  /// Fencing token the stale writer believed it owned.
  fencingToken BigInt
  /// What it tried to do (bounded, secret-free).
  detail       String   @db.VarChar(500)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  stepRun ExperimentStepRun @relation(fields: [stepRunId], references: [id], onDelete: Restrict)

  @@index([stepRunId])
  @@map("stale_writer_event")
  @@schema("control")
}

// =====================================================================
// Phase 4 — EVIDENCE context (evidence schema)
// =====================================================================
// Canonical terminology per docs/evidence-model.md §1–§6 and ADR-0006:
//   RawObservation      — what RuptureGrid actually observed (OBSERVED)
//   NormalizedEvent     — deterministic versioned projection (DERIVED)
//   CausalRelationship  — identity-backed linkage between events (DERIVED)
//   EvidenceIntegrityHead — per-run hash-chain head pointer
//
// Integrity contract (evidence-model §4, stated honestly):
//   - LOGICALLY APPEND-ONLY: no application update/delete path exists
//     for observations/events/relationships; corrections append new
//     records. NOT claimed: immutable / tamper-proof / non-repudiable.
//   - CONTENT-ADDRESSED: contentHash is the SHA-256 of the canonical
//     stored REDACTED representation (redaction before persistence —
//     security-boundaries §7, ADR-0012). It is NOT a hash of "exact
//     raw wire bytes".
//   - HASH-CHAINED PER RUN: each observation records its predecessor's
//     contentHash; the run's chain head lives in evidence_integrity_head.
//     Post-hoc modification by the application's writers is detectable.

/// Raw observation kinds (evidence-model §3 initial contract).
enum ObservationKind {
  http_request_observed
  http_response_observed
  delivery_emitted
  executor_error
  target_observation

  @@schema("evidence")
}

/// Origin classes (evidence-model §2). Phase 4 writes only OBSERVED
/// and DETERMINISTIC_DERIVED rows; AI_INTERPRETED exists as a value so
/// a future phase cannot silently widen the truth path (ADR-0007).
enum EvidenceOrigin {
  OBSERVED
  DETERMINISTIC_DERIVED
  AI_INTERPRETED

  @@schema("evidence")
}

/// One raw observation of one physical invocation or adapter read.
/// Not fenced (observed reality is attributed, never erased —
/// architecture §10): a stale generation's truthful observation may be
/// appended, carrying ITS writer identity; it can never regain
/// authority over execution state.
model RawObservation {
  id                 String         @id @default(uuid()) @db.Uuid
  runId              String         @db.Uuid
  stepRunId          String?        @db.Uuid
  /// StepInvocation row this observation belongs to (execution
  /// correlation; evidence remains a separate concept — §13).
  invocationId       String?        @db.Uuid
  /// The target-facing per-invocation identity observed on the wire.
  invocationIdentity String?        @db.VarChar(120)
  kind               ObservationKind
  /// Explicit evidence-adapter kind for target_observation rows (e.g.
  /// demo-fintech-payment-lineage). Never inferred from paths.
  adapterKind        String?        @db.VarChar(64)
  /// Versioned schema of `payload` so old evidence stays interpretable.
  schemaVersion      String         @db.VarChar(32)
  observedAt         DateTime       @db.Timestamptz(6)
  /// The STORED REDACTED representation (bounded). Never raw secret-
  /// bearing bytes (ADR-0012); `redactionApplied` records honestly that
  /// redaction transformed the captured data.
  payload            Json
  redactionApplied   Boolean
  redactionPolicyVersion String     @db.VarChar(32)
  truncated          Boolean        @default(false)
  /// SHA-256 hex of the canonical UTF-8 bytes of the stored
  /// representation (redaction applied BEFORE hashing). An integrity
  /// and traceability field — NOT a global identity: two runs observing
  /// identical content each keep their own observation row.
  contentHash        String         @db.VarChar(64)
  /// Position of this observation in its run's hash chain (0-based,
  /// gap-free under the append lock).
  chainIndex         Int
  /// contentHash of the predecessor observation of this run.
  prevContentHash    String?        @db.VarChar(64)
  origin             EvidenceOrigin
  /// Writer provenance: which worker generation captured this.
  writerOwnerId      String         @db.VarChar(120)
  writerFencingToken BigInt?
  createdAt          DateTime       @default(now()) @db.Timestamptz(6)

  run     ExperimentRun      @relation(fields: [runId], references: [id], onDelete: Restrict)
  stepRun ExperimentStepRun? @relation(fields: [stepRunId], references: [id], onDelete: Restrict)

  /// Observation identity = provenance tuple. An exact re-persistence
  /// of the SAME physical invocation's observation resolves to ONE row
  /// (idempotent retry); a different invocation — or a different run
  /// reusing an identity string — is a DIFFERENT observation (its own
  /// row), never an alias of other runs' evidence.
  @@unique([runId, kind, invocationIdentity])
  @@index([runId, chainIndex])
  @@index([contentHash])
  @@index([runId, kind])
  @@index([stepRunId])
  @@map("raw_observation")
  @@schema("evidence")
}

/// Deterministic versioned projection of one or more raw observations
/// (evidence-model §1 NORMALIZED EVENT). Re-running the same normalizer
/// version on the same input produces the same row (input-hash unique).
model NormalizedEvent {
  id                    String         @id @default(uuid()) @db.Uuid
  runId                 String         @db.Uuid
  /// Typed event name, namespaced by normalizer (e.g.
  /// demo.payment-delivery-observed).
  eventType             String         @db.VarChar(64)
  /// Business subject identity when the event has one (e.g. the
  /// providerPaymentId) — the join key for attribution.
  subjectKey            String?        @db.VarChar(200)
  payload               Json
  normalizerName        String         @db.VarChar(80)
  normalizerVersion     String         @db.VarChar(32)
  /// SHA-256 of the canonical input tuple (source observation content
  /// hashes) — derivation idempotency.
  inputHash             String         @db.VarChar(64)
  origin                EvidenceOrigin @default(DETERMINISTIC_DERIVED)
  /// Content hashes of the source RawObservations (traceability raw →
  /// derived).
  sourceObservationHashes String[]
  /// Chain index of the anchoring observation, when single-sourced.
  primaryObservationIndex Int?
  createdAt             DateTime       @default(now()) @db.Timestamptz(6)

  run            ExperimentRun       @relation(fields: [runId], references: [id], onDelete: Restrict)
  fromRelations  CausalRelationship[] @relation("CausalRelationshipFromEvent")
  toRelations    CausalRelationship[] @relation("CausalRelationshipToEvent")

  @@unique([runId, normalizerName, normalizerVersion, inputHash])
  @@index([runId, eventType])
  @@index([runId, subjectKey])
  @@map("normalized_event")
  @@schema("evidence")
}

/// Identity-backed relationship between two normalized events
/// (evidence-model §6). Basis is the CANONICAL hyphenated form:
///   identity-direct | identity-chain | temporal-correlation
/// temporal-correlation is recorded only as a weak hint and can never
/// be the sole support of a FAIL verdict (§6, §7).
model CausalRelationship {
  id           String   @id @default(uuid()) @db.Uuid
  runId        String   @db.Uuid
  fromEventId  String   @db.Uuid
  toEventId    String   @db.Uuid
  relationKind String   @db.VarChar(64)
  basis        String   @db.VarChar(24)
  /// The explicit linkage proof: which identity fields in which
  /// payloads matched. Secret-free by redaction before persistence.
  evidenceJson Json
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  run       ExperimentRun  @relation(fields: [runId], references: [id], onDelete: Restrict)
  fromEvent NormalizedEvent @relation("CausalRelationshipFromEvent", fields: [fromEventId], references: [id], onDelete: Restrict)
  toEvent   NormalizedEvent @relation("CausalRelationshipToEvent", fields: [toEventId], references: [id], onDelete: Restrict)

  @@unique([runId, fromEventId, toEventId, relationKind, basis])
  @@index([runId])
  @@index([fromEventId])
  @@index([toEventId])
  @@map("causal_relationship")
  @@schema("evidence")
}

/// Per-run hash-chain head (evidence-model §4: "the run stores the
/// final chain head"). A mutable pointer row by design — it is
/// coordination metadata, not observation truth.
model EvidenceIntegrityHead {
  runId             String   @id @db.Uuid
  lastChainIndex    Int
  headContentHash   String   @db.VarChar(64)
  observationCount  Int
  updatedAt         DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  /// Last verification outcome (recomputed chain). Verification is
  /// re-runnable; it never rewrites observation rows.
  lastVerifiedAt    DateTime? @db.Timestamptz(6)
  lastVerifiedHeadHash String? @db.VarChar(64)
  lastVerifiedObservationCount Int?

  run ExperimentRun @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@map("evidence_integrity_head")
  @@schema("evidence")
}

// =====================================================================
// Phase 4 — ANALYSIS context (analysis schema)
// =====================================================================
// Deterministic business-invariant evaluation (evidence-model §7,
// ADR-0006). Deliberately ABSENT (R-01 phase boundaries): Finding,
// finding severity, forensic timeline, reproduction definitions —
// those are Phase 5.

/// Invariant verdicts are EXACTLY these three (evidence-model §1/§7).
/// NOT_EVALUABLE is first-class: insufficient evidence is "cannot
/// determine", never a silent pass.
enum InvariantVerdict {
  PASS
  FAIL
  NOT_EVALUABLE

  @@schema("analysis")
}

/// A declared, versioned business rule. v1 carries exactly one:
/// INV-IZ-1 (incident-zero §5).
model InvariantDefinition {
  id           String   @id @default(uuid()) @db.Uuid
  invariantKey String   @unique @db.VarChar(80)
  title        String   @db.VarChar(200)
  description  String   @db.VarChar(1000)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  evaluations InvariantEvaluation[]

  @@map("invariant_definition")
  @@schema("analysis")
}

/// One analysis pass of one (run, invariant, evaluator version).
/// Unique per tuple: concurrent/repeat analysis converges on ONE batch
/// row; later NEW evidence produces NEW evaluation rows on the SAME
/// batch — history is never rewritten (idempotency by input hash).
model EvaluationBatch {
  id               String    @id @default(uuid()) @db.Uuid
  runId            String    @db.Uuid
  invariantKey     String    @db.VarChar(80)
  evaluatorVersion String    @db.VarChar(32)
  startedAt        DateTime  @default(now()) @db.Timestamptz(6)
  completedAt      DateTime? @db.Timestamptz(6)
  evaluationCount  Int       @default(0)

  run         ExperimentRun         @relation(fields: [runId], references: [id], onDelete: Restrict)
  evaluations InvariantEvaluation[]

  @@unique([runId, invariantKey, evaluatorVersion])
  @@index([runId])
  @@map("evaluation_batch")
  @@schema("analysis")
}

/// One deterministic evaluation of one invariant for one subject
/// (evidence-model §7). Same inputs (evidence set + target-state
/// verification + evaluator version) ⇒ same verdict and the same
/// evidenceSetHash, persisted ONCE. Re-evaluation under a new
/// evaluator version adds a new row — never a mutation.
model InvariantEvaluation {
  id               String           @id @default(uuid()) @db.Uuid
  batchId          String           @db.Uuid
  runId            String           @db.Uuid
  invariantKey     String           @db.VarChar(80)
  evaluatorVersion String           @db.VarChar(32)
  /// The business subject evaluated (e.g. providerPaymentId).
  subjectKey       String           @db.VarChar(200)
  verdict          InvariantVerdict
  /// Bounded human-readable justification (deterministic, secret-free).
  reason           String           @db.VarChar(500)
  /// SHA-256 of the canonical evidence-set input tuple. Deterministic
  /// fingerprint of everything this verdict rests on.
  evidenceSetHash  String           @db.VarChar(64)
  /// What the completeness claim rests on (e.g. lineage-complete,
  /// delivery-attributable).
  completenessBasis String          @db.VarChar(64)
  /// Secret-free structured detail (counted effects, bases, gaps).
  details          Json
  /// Traceability: content hashes of every raw observation, ids of
  /// every normalized event and causal relationship used.
  sourceObservationHashes String[]
  normalizedEventIds      String[]
  causalRelationshipIds   String[]
  createdAt        DateTime         @default(now()) @db.Timestamptz(6)

  batch     EvaluationBatch     @relation(fields: [batchId], references: [id], onDelete: Restrict)
  run       ExperimentRun       @relation(fields: [runId], references: [id], onDelete: Restrict)
  invariant InvariantDefinition @relation(fields: [invariantKey], references: [invariantKey], onDelete: Restrict)
  findings  Finding[]

  @@unique([runId, invariantKey, evaluatorVersion, subjectKey, evidenceSetHash])
  @@index([runId])
  @@index([batchId])
  @@map("invariant_evaluation")
  @@schema("analysis")
}

// =====================================================================
// Phase 5 — FORENSIC ANALYSIS (analysis schema)
// =====================================================================
// Findings and the forensic timeline are DERIVED investigator-facing
// artifacts (docs/phase-roadmap.md Phase 5, evidence-model §8/§9):
//   - A Finding is an investigator-facing deterministic statement
//     derived from an ALREADY-PERSISTED InvariantEvaluation. It never
//     re-evaluates evidence, never contradicts the evaluation, and
//     carries full provenance: evaluation → events → relationships →
//     observation hashes → run/steps/invocations.
//   - The forensic timeline is the investigation representation of the
//     run (evidence-model §9): every entry cites its source row, every
//     ordering carries an explicit basis, and timeline entries NEVER
//     assert causality — only the cited CausalRelationship does.
//   - Reproduction definitions capture the durable "how to intentionally
//     execute the same experiment intent again" record (ADR-0010,
//     incident-replay §1) — the snapshot is already the authoritative
//     frozen intent; this row binds it to the run.
//   - Run comparisons are the post-fix-replay groundwork (incident-replay
//     §6): side-by-side verdicts for the same invariant across two runs
//     sharing a snapshot hash.
//
// Identity/idempotency (finding identity converges; repeated analysis
// must not duplicate): semantic identity = (runId, invariantEvaluationId,
// findingRuleVersion) enforced by a DB unique key. Timeline identity =
// (runId, derivationVersion, sourceKind, sourceId, entryKind) — the same
// source under the same derivation version is ONE entry. Creation
// timestamps never participate in semantic identity (§32).

/// Deterministic failure-reason codes (bounded vocabulary, §14). Phase 5
/// defines exactly one: the duplicate-credit Finding for a FAILed
/// INV-IZ-1. PASS and NOT_EVALUABLE produce NO Finding (§10/§41:
/// uncertainty is never converted into a defect).
enum FindingReasonCode {
  DUPLICATE_EQUIVALENT_FINANCIAL_EFFECT

  @@schema("analysis")
}

/// The evidence subject of a Finding / TimelineEntry (§29/§47): every
/// source reference is TYPED — a string id alone would pretend to be an
/// FK without being one (§63).
enum EvidenceSubjectKind {
  RUN
  STEP_RUN
  INVOCATION
  RAW_OBSERVATION
  NORMALIZED_EVENT
  CAUSAL_RELATIONSHIP
  INVARIANT_EVALUATION
  FINDING

  @@schema("analysis")
}

/// Timeline entry kinds (small explicit deterministic taxonomy, §20 —
/// derived from the accepted Phase 3/4 truth, never decorative).
enum TimelineEntryKind {
  RUN_TERMINAL_STATE
  STEP_TERMINAL_STATE
  INVOCATION_EXECUTED
  HTTP_REQUEST_OBSERVED
  HTTP_RESPONSE_OBSERVED
  EXECUTOR_ERROR_OBSERVED
  PROVIDER_PAYMENT_OBSERVED
  PROVIDER_EVENT_OBSERVED
  WEBHOOK_DELIVERY_OBSERVED
  PROCESSING_ATTEMPT_OBSERVED
  FINANCIAL_EFFECT_OBSERVED
  LEDGER_ENTRY_OBSERVED
  TARGET_STATE_OBSERVED
  PAYMENT_DELIVERY_OBSERVED
  INVARIANT_EVALUATED
  FINDING_DERIVED
  /// Phase 9 (docs/controlled-faults.md §6, ADR-0014): target-owned
  /// controlled-fault plan CONFIGURED — a fault-status observation
  /// reporting the plan of this kind currently armed (target-authored
  /// configuration truth from the read-only inspection API).
  FAULT_PLAN_CONFIGURED
  /// Phase 9 (docs/controlled-faults.md §6, ADR-0014): target-owned
  /// controlled-fault plan ACTIVATED — the SAME observation class, but
  /// derived ONLY when the target's own trigger accounting shows
  /// triggersUsed ≥ 1 (budget consumption is the persisted basis for
  /// "activated"; it is never inferred from error shapes). Configured
  /// and activated are separate facts and remain separate entries.
  FAULT_PLAN_ACTIVATED

  @@schema("analysis")
}

/// How a timeline entry's position was determined (evidence-model §9:
/// every ordering carries an explicit basis).
enum TimelineOrderingBasis {
  sequence
  wall_clock
  unordered_overlap

  @@schema("analysis")
}

/// One deterministic investigator-facing conclusion derived from ONE
/// persisted InvariantEvaluation (evidence-model §8). Semantic content
/// is immutable after creation; a changed rule version appends a NEW
/// Finding — history is never rewritten (§45).
model Finding {
  id                 String   @id @default(uuid()) @db.Uuid
  runId              String   @db.Uuid
  /// The authoritative Phase 4 evaluation this Finding rests on. The
  /// Finding NEVER re-computes a verdict: one business truth engine.
  invariantEvaluationId String @db.Uuid
  invariantKey       String   @db.VarChar(80)
  evaluatorVersion   String   @db.VarChar(32)
  /// Version of the deterministic finding rule that produced this row.
  findingRuleVersion String   @db.VarChar(32)
  /// The business subject (e.g. providerPaymentId) — mirrors the
  /// evaluation's subject; one failing subject = one Finding (§43).
  subjectKey         String   @db.VarChar(200)
  reasonCode         FindingReasonCode
  /// Deterministic bounded title from fixed templates (§15). No AI prose.
  title              String   @db.VarChar(200)
  /// Deterministic bounded summary from the evaluation's own details.
  summary            String   @db.VarChar(500)
  /// SHA-256 over the canonical input tuple: rule version, evaluation
  /// identity, subject, and the ordered proof-reference set (§32). Wall
  /// clock never enters semantic identity.
  inputFingerprint   String   @db.VarChar(64)
  /// Deterministic structured detail (counts, amounts, basis) copied
  /// from the evaluation — never recomputed (§96/§50).
  details            Json
  /// Confidence scope (evidence-model §8): what the evidence PROVES
  /// versus what remains uncertain — INDETERMINATE invocation outcomes
  /// and non-identity attribution dependencies are listed explicitly,
  /// never smoothed over. Deterministic, derived from the run's own
  /// persisted execution rows; never an LLM judgement (ADR-0007).
  provenScope        Json
  uncertainScope     Json
  createdAt          DateTime @default(now()) @db.Timestamptz(6)

  run            ExperimentRun       @relation(fields: [runId], references: [id], onDelete: Restrict)
  evaluation     InvariantEvaluation @relation(fields: [invariantEvaluationId], references: [id], onDelete: Restrict)
  evidenceRefs   FindingEvidenceReference[]

  /// Semantic idempotency is a DATABASE constraint, not an
  /// application-level check (§64): the same evaluation under the same
  /// rule version converges on ONE Finding row.
  @@unique([invariantEvaluationId, findingRuleVersion])
  @@index([runId])
  @@index([runId, subjectKey])
  @@index([invariantKey])
  @@index([reasonCode])
  @@map("finding")
  @@schema("analysis")
}

/// Minimal sufficient proof references for a Finding (§29): only the
/// events/relationships/observations that constitute the proof, typed
/// and deterministically selected — never "every observation in the run".
model FindingEvidenceReference {
  id        String  @id @default(uuid()) @db.Uuid
  findingId String  @db.Uuid
  subject   EvidenceSubjectKind
  /// Durable row id (or observation contentHash for RAW_OBSERVATION —
  /// the stable raw-evidence handle Phase 4 already exposes).
  sourceId  String  @db.VarChar(200)
  /// Role of this reference in the proof (bounded, deterministic).
  role      String  @db.VarChar(64)
  /// Deterministic 1-based position within the Finding's proof set.
  position  Int

  finding Finding @relation(fields: [findingId], references: [id], onDelete: Restrict)

  @@unique([findingId, sourceId, role])
  @@index([findingId])
  @@map("finding_evidence_reference")
  @@schema("analysis")
}

/// One forensic-timeline entry (evidence-model §9). Persisted,
/// versioned, recomputable: repeated derivation over identical inputs
/// converges on the SAME semantic rows (§68). Every entry cites its
/// source row; causality claims live ONLY in the cited
/// CausalRelationship — adjacency in this timeline is not causality
/// (§23). Ordering carries an explicit basis (§21/§22).
model ForensicTimelineEntry {
  id                String @id @default(uuid()) @db.Uuid
  runId             String @db.Uuid
  derivationVersion String @db.VarChar(32)
  entryKind         TimelineEntryKind
  /// TYPED source reference (§47): the durable row (or observation
  /// contentHash) this entry presents. No source-less entries.
  sourceKind        EvidenceSubjectKind
  sourceId          String @db.VarChar(200)
  /// Explicit ordering basis (evidence-model §9): `sequence` for
  /// engine-assigned ordinals, `wall_clock` where only timestamps
  /// exist, `unordered_overlap` for genuinely concurrent observations
  /// (order not knowable, not asserted).
  orderingBasis     TimelineOrderingBasis
  /// Engine ordinal where the source has one (step sequence, invocation
  /// sequence, observation chain index), else 0. Display/filter
  /// metadata — the persisted total order is time-primary
  /// (occurredAt, sourceKind, sourceId, entryKind) with this ordinal
  /// exposed for identity (§22).
  sequenceNumber    Int
  /// Wall-clock instant of the underlying source (execution time,
  /// observedAt, or derivedAt — the semantics are named in `timeMeaning`).
  occurredAt        DateTime @db.Timestamptz(6)
  /// Which time semantic `occurredAt` carries (§21): never one fake
  /// event timestamp collapsed across meanings.
  timeMeaning       String  @db.VarChar(40)
  /// The business subject when the entry has one (providerPaymentId…).
  subjectKey        String? @db.VarChar(200)
  /// Safe derived detail copied from the stored source (§99). Secret-
  /// free by construction: sources were redacted before persistence.
  details           Json
  createdAt         DateTime @default(now()) @db.Timestamptz(6)

  run ExperimentRun @relation(fields: [runId], references: [id], onDelete: Restrict)

  /// Same source under the same derivation version is ONE entry —
  /// concurrent/repeat derivation converges (§65).
  @@unique([runId, derivationVersion, sourceKind, sourceId, entryKind])
  @@index([runId, occurredAt])
  @@index([runId, sequenceNumber])
  @@index([runId, entryKind])
  @@index([runId, subjectKey])
  @@map("forensic_timeline_entry")
  @@schema("analysis")
}

/// One durable forensic-derivation pass over one run (§33): records the
/// derivation version + the input fingerprint the outputs rest on, so
/// recomputability is auditable. Repeat passes with identical input
/// converge on the same row (unique per run + version + fingerprint).
model ForensicDerivation {
  id                 String   @id @default(uuid()) @db.Uuid
  runId              String   @db.Uuid
  derivationVersion  String   @db.VarChar(32)
  /// Fingerprint over the derivation INPUT tuple: finding-rule inputs
  /// (evaluations) + timeline source set (execution rows, observation
  /// hashes, derived events/relationships). Identical inputs ⇒ identical
  /// fingerprint ⇒ identical outputs (§135).
  inputFingerprint   String   @db.VarChar(64)
  startedAt          DateTime @default(now()) @db.Timestamptz(6)
  completedAt        DateTime? @db.Timestamptz(6)
  findingCount       Int      @default(0)
  timelineEntryCount Int      @default(0)

  run ExperimentRun @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@unique([runId, derivationVersion, inputFingerprint])
  @@index([runId])
  @@map("forensic_derivation")
  @@schema("analysis")
}

/// Durable record binding one run to its frozen execution intent for
/// reproduction (incident-replay §1). The RunSnapshot (hash-pinned,
/// append-only) remains the authoritative intent; this row binds the
/// run → snapshot → experiment → target with the run's invariant
/// results, so an investigator can answer "can we reproduce this?"
/// from durable truth alone.
model ReproductionDefinition {
  id              String @id @default(uuid()) @db.Uuid
  runId           String @db.Uuid
  snapshotId      String @db.Uuid
  snapshotContentHash String @db.VarChar(64)
  /// The target processing mode the experiment requires (incident-replay
  /// §1.2), extracted from the frozen snapshot steps.
  targetModeRequirement String? @db.VarChar(32)
  /// Credential REFERENCE names required (never values, ADR-0012).
  credentialRefs  String[]
  /// Invariant definitions (versioned) the replay must evaluate.
  invariantBindings Json
  /// Expected outcome classes (incident-replay §1.6) — for the
  /// canonical scenario the run's own deterministic verdicts.
  acceptanceExpectations Json
  /// Phase 9 (docs/controlled-faults.md §17, ADR-0014): the frozen
  /// controlled-fault INTENT of the run's snapshot steps — planVersion,
  /// faultKind, activation, maxTriggers, and the wave stagger — derived
  /// from the snapshot (never from live state), with credential
  /// REFERENCE names only and NO credential values. Empty when the run
  /// declares no fault.
  faultIntent Json?
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  run      ExperimentRun @relation(fields: [runId], references: [id], onDelete: Restrict)
  snapshot RunSnapshot   @relation(fields: [snapshotId], references: [id], onDelete: Restrict)

  /// One reproduction definition per run (its snapshot is already
  /// unique per run creation).
  @@unique([runId])
  @@index([snapshotId])
  @@map("reproduction_definition")
  @@schema("analysis")
}
