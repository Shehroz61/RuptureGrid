{
  "name": "@rupturegrid/control-db",
  "version": "1.0.0",
  "private": true,
  "description": "RuptureGrid Control PostgreSQL ownership boundary (control/evidence/analysis schemas)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "generate": "prisma generate --config prisma.config.ts",
    "migrate:deploy": "prisma migrate deploy --config prisma.config.ts",
    "migrate:dev": "prisma migrate dev --config prisma.config.ts",
    "migrate:diff": "prisma migrate diff --config prisma.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@rupturegrid/config": "workspace:*"
  },
  "devDependencies": {
    "prisma": "^7.10.0",
    "typescript": "^5.9.3"
  }
}
