# Normalize line endings: LF in repository and working tree for text files.
* text=auto eol=lf

# Source
*.ts text
*.tsx text
*.js text
*.mjs text
*.cjs text
*.json text
*.md text
*.yml text
*.yaml text
*.sql text
*.prisma text

# Windows scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binaries
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.mp4 binary
