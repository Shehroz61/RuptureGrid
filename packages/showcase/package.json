{
  "name": "@rupturegrid/showcase",
  "version": "1.0.0",
  "private": true,
  "description": "Phase 8 showcase automation: captures the accepted Phase 6 product UI over real golden execution data produced by the accepted Phase 7 verifier — no separate truth engine, no fabricated artifacts",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "showcase-generate": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@rupturegrid/config": "workspace:*",
    "@rupturegrid/control-db": "workspace:*",
    "@rupturegrid/incident-zero": "workspace:*",
    "@rupturegrid/shared": "workspace:*",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "playwright": "^1.63.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  }
}
