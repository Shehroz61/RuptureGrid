# =====================================================================
# RuptureGrid v1.0 — environment template
# =====================================================================
# Copy this file to `.env` and adjust for your machine. NEVER commit `.env`.
# All values below are NON-PRODUCTION development examples.
#
# Infrastructure services (control-postgres, demo-postgres, redis) are
# defined in compose.yaml and read the POSTGRES_*/REDIS_* variables below.
# The DATABASE_URL/REDIS_URL values used by applications must match the
# credentials configured for those services.

# --- Shared -----------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# --- RuptureGrid Control Plane (apps/api, apps/worker) ----------------
API_HOST=127.0.0.1
API_PORT=3001
# RuptureGrid Control PostgreSQL (control-postgres service, host port 5443)
CONTROL_DATABASE_URL=postgresql://rupturegrid:rupturegrid_dev_password@127.0.0.1:5443/rupturegrid
CONTROL_SHADOW_DATABASE_URL=postgresql://rupturegrid:rupturegrid_dev_password@127.0.0.1:5443/rupturegrid_shadow
# Redis (redis service, host port 6380). Coordination-only in RuptureGrid.
REDIS_URL=redis://127.0.0.1:6380
# BullMQ key prefix shared by every queue participant.
QUEUE_PREFIX=rupturegrid
# Worker execution tuning (lease uses PostgreSQL time; heartbeat ≤ lease/2).
WORKER_LEASE_DURATION_MS=30000
WORKER_HEARTBEAT_INTERVAL_MS=10000
WORKER_RECONCILE_INTERVAL_MS=10000
WORKER_CONCURRENCY=4
# Explicit development origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:3000
#
# Phase 16 (ADR-0024) — SERVER-OWNED platform target-origin credential
# grants (packages/config TARGET_ORIGIN_CREDENTIAL_GRANTS, consumed by
# apps/api). JSON mapping each NORMALIZED origin authority to the
# credential reference NAMES authorized for it. Reference names and
# origins only — secret VALUES are structurally impossible here
# (R-13/ADR-0012). This is platform configuration maintained OUTSIDE
# the target-registration request path: a registration request can
# never grant itself credentials. Every named ref must be a member of
# EXECUTOR_CREDENTIAL_REFS (stale grants fail startup). Multi-origin
# targets require the grant on EVERY origin (intersection — ADR-0024
# §6). Empty/absent = no grants (fail-closed default).
TARGET_ORIGIN_CREDENTIAL_GRANTS={"http://127.0.0.1:3002":["DEMO_ADMIN_TOKEN","DEMO_INSPECTION_TOKEN","DEMO_PROVIDER_SIGNING_SECRET"],"http://127.0.0.1:3003":["COMMERCE_ADMIN_TOKEN","DEMO_COMMERCE_SIGNING_SECRET"]}

# --- Demo Fintech target (apps/demo-fintech) --------------------------
DEMO_HOST=127.0.0.1
DEMO_PORT=3002
# Demo Fintech PostgreSQL (demo-postgres service, host port 5444).
# Owned by the Demo Fintech application ONLY. RuptureGrid never receives it.
DEMO_DATABASE_URL=postgresql://demo:demo_dev_password@127.0.0.1:5444/demo_fintech
# Shadow database for Prisma migration verification (reviewable migrations,
# R-12). Owned by the Demo Fintech PostgreSQL instance. compose does not
# auto-create it; `pnpm db:migrate` (migrate deploy) does not need it. For
# `migrate dev`/`migrate diff`, create it once:
#   psql "$DEMO_DATABASE_URL" -c 'CREATE DATABASE demo_fintech_shadow;'
DEMO_SHADOW_DATABASE_URL=postgresql://demo:demo_dev_password@127.0.0.1:5444/demo_fintech_shadow
# Demo-target credentials. CLEARLY NON-PRODUCTION example values — the
# Demo Target is a local/development/authorized-test system only.
#   DEMO_ADMIN_TOKEN        target-owned reset / mode / provider-simulator routes
#   DEMO_INSPECTION_TOKEN   read-only inspection API (no admin capability)
#   DEMO_PROVIDER_SIGNING_SECRET  HMAC-SHA256 secret for provider webhook authenticity
DEMO_ADMIN_TOKEN=demo-admin-dev-token-0001
DEMO_INSPECTION_TOKEN=demo-inspection-dev-token-0001
DEMO_PROVIDER_SIGNING_SECRET=demo-provider-signing-secret-0001

# The worker resolves these credential VALUES at execution time when a
# target registration or experiment step declares the reference name.
# They are never logged, never persisted, and never appear in snapshots
# or queue payloads (ADR-0012). Note the shared dev .env already defines
# them for the Demo app; the executor reads the same names.

# --- Demo Commerce target (apps/demo-commerce) — Phase 16 -------------
COMMERCE_HOST=127.0.0.1
COMMERCE_PORT=3003
# Demo Commerce PostgreSQL (commerce-postgres service, host port 5445).
# Owned by the Demo Commerce application ONLY. RuptureGrid never receives
# it (ADR-0002/R-05 — mirroring the Demo Fintech boundary).
COMMERCE_DATABASE_URL=postgresql://commerce:commerce_dev_password@127.0.0.1:5445/demo_commerce
# Shadow database for Prisma migration verification (R-12). compose does
# not auto-create it; `pnpm db:migrate` (migrate deploy) does not need it.
# For `migrate dev`/`migrate diff`, create it once:
#   psql "$COMMERCE_DATABASE_URL" -c 'CREATE DATABASE demo_commerce_shadow;'
COMMERCE_SHADOW_DATABASE_URL=postgresql://commerce:commerce_dev_password@127.0.0.1:5445/demo_commerce_shadow
# Commerce-target credentials. CLEARLY NON-PRODUCTION example values.
#   COMMERCE_ADMIN_TOKEN           target-owned scenario/mode/fault routes
#   DEMO_COMMERCE_SIGNING_SECRET   HMAC-SHA256 secret for checkout authenticity
# (No COMMERCE_INSPECTION_TOKEN exists: the Phase 14 generic inspection
# adapter is credential-free by contract, so the Commerce inspection
# surface accepts no bearer token either.)
COMMERCE_ADMIN_TOKEN=commerce-admin-dev-token-0001
DEMO_COMMERCE_SIGNING_SECRET=demo-commerce-signing-secret-0001

# --- Web (apps/web) ---------------------------------------------------
# Next.js reads PORT natively; default 3000.
PORT=3000

# --- Optional verifier knobs -------------------------------------------
# Incident Zero leak-scan canary (OPT-IN, disabled by default). Set to any
# value of at least 16 characters to scan every evidence store and child
# output for that canary during `pnpm incident-zero:verify`; leaks are
# reported by location, never by value.
# RG_GOLDEN_CANARY=
# Controlled Faults per-scenario timeout in milliseconds (optional; default
# 180000) for `pnpm controlled-faults:verify`.
# RG_CF_SCENARIO_TIMEOUT_MS=180000

# --- Infrastructure host ports / credentials (compose.yaml) -----------
CONTROL_POSTGRES_PORT=5443
CONTROL_POSTGRES_USER=rupturegrid
CONTROL_POSTGRES_PASSWORD=rupturegrid_dev_password
CONTROL_POSTGRES_DB=rupturegrid

DEMO_POSTGRES_PORT=5444
DEMO_POSTGRES_USER=demo
DEMO_POSTGRES_PASSWORD=demo_dev_password
DEMO_POSTGRES_DB=demo_fintech

COMMERCE_POSTGRES_PORT=5445
COMMERCE_POSTGRES_USER=commerce
COMMERCE_POSTGRES_PASSWORD=commerce_dev_password
COMMERCE_POSTGRES_DB=demo_commerce

REDIS_PORT=6380