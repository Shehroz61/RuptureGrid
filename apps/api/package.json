{
  "name": "@rupturegrid/api",
  "version": "1.0.0",
  "private": true,
  "description": "RuptureGrid Control Plane HTTP application shell (Phase 1)",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "node --watch dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "@rupturegrid/config": "workspace:*",
    "@rupturegrid/engine": "workspace:*",
    "@rupturegrid/evidence": "workspace:*",
    "@rupturegrid/control-db": "workspace:*",
    "@rupturegrid/forensics": "workspace:*",
    "@rupturegrid/logger": "workspace:*",
    "@rupturegrid/queue": "workspace:*",
    "@rupturegrid/shared": "workspace:*",
    "express": "^5.2.1",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  }
}
