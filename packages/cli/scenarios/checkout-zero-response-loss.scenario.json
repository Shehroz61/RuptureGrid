{
  "schemaVersion": "rupturegrid-scenario/v1",
  "name": "checkout-zero-response-loss",
  "description": "Checkout Zero response-loss probe: the target's own admin API arms its declared RESPONSE_TRUNCATION hook (one trigger); a single signed checkout submission then commits its order but loses the response mid-body, so the physical invocation is honestly INDETERMINATE. The business invariants still hold: exactly one accepted order, stock conserved. Expectations record verdict intent only; no exitClass is declared because expectations never influence classification.",
  "target": {
    "displayName": "checkout-zero-commerce"
  },
  "experiment": {
    "steps": [
      {
        "name": "establish-scenario",
        "action": {
          "method": "POST",
          "relativePath": "/demo/admin/scenario",
          "headers": {
            "content-type": "application/json",
            "authorization": "Bearer ${credential.COMMERCE_ADMIN_TOKEN}"
          },
          "body": "{\"scopeToken\":\"checkout-zero-response-loss\",\"sku\":\"SKU-001\",\"initialAvailableUnits\":1,\"mode\":\"VULNERABLE\"}",
          "mutation": "MUTATING",
          "retryPolicy": "NONE",
          "repeat": 1,
          "concurrency": 1,
          "contract": "GENERIC_HTTP",
          "credentialRefs": ["COMMERCE_ADMIN_TOKEN"]
        }
      },
      {
        "name": "arm-truncation-fault",
        "action": {
          "method": "PUT",
          "relativePath": "/demo/admin/faults/RESPONSE_TRUNCATION",
          "headers": {
            "content-type": "application/json",
            "authorization": "Bearer ${credential.COMMERCE_ADMIN_TOKEN}"
          },
          "body": "{\"planVersion\":\"controlled-fault/v1\",\"activation\":\"first_n_matching_deliveries\",\"maxTriggers\":1}",
          "mutation": "MUTATING",
          "retryPolicy": "NONE",
          "repeat": 1,
          "concurrency": 1,
          "contract": "GENERIC_HTTP",
          "credentialRefs": ["COMMERCE_ADMIN_TOKEN"]
        }
      },
      {
        "name": "checkout-submit",
        "action": {
          "method": "POST",
          "relativePath": "/checkout/submit",
          "headers": {
            "content-type": "application/json",
            "x-commerce-signature": "${signature}"
          },
          "body": "{\"checkoutIntentId\":\"CHK-RL-001\",\"customerId\":\"CUST-001\",\"cartId\":\"CART-001\",\"totalMinor\":\"500000\",\"currency\":\"PKR\",\"sku\":\"SKU-001\"}",
          "mutation": "MUTATING",
          "retryPolicy": "NONE",
          "repeat": 1,
          "concurrency": 1,
          "contract": "GENERIC_HTTP"
        }
      },
      {
        "name": "disarm-truncation-fault",
        "action": {
          "method": "DELETE",
          "relativePath": "/demo/admin/faults/RESPONSE_TRUNCATION",
          "headers": {
            "authorization": "Bearer ${credential.COMMERCE_ADMIN_TOKEN}"
          },
          "mutation": "MUTATING",
          "retryPolicy": "NONE",
          "repeat": 1,
          "concurrency": 1,
          "contract": "GENERIC_HTTP",
          "credentialRefs": ["COMMERCE_ADMIN_TOKEN"]
        }
      }
    ],
    "invariantBindings": [
      {
        "key": "INV-CHK-1",
        "kind": "atMostOneAcceptedEffect",
        "registryVersion": "business-invariant/v1",
        "params": {
          "subjectRole": "checkoutIntent",
          "subjectIdentityField": "checkoutIntentId",
          "effectRole": "order",
          "effectIdentityField": "orderId",
          "acceptedMatch": {
            "field": "status",
            "value": "ACCEPTED"
          },
          "equivalenceFields": [
            "checkoutIntentId",
            "customerId",
            "cartId",
            "totalMinor",
            "currency"
          ],
          "maxAcceptedEffects": 1,
          "completenessProof": {
            "kind": "observed-total",
            "queryId": "ordersSummary",
            "subjectField": "checkoutIntentId",
            "totalField": "acceptedOrderTotal"
          },
          "scopeBinding": {
            "fields": ["verificationScopeId"],
            "generationField": "generationId"
          }
        }
      },
      {
        "key": "INV-INV-1",
        "kind": "resourceConservation",
        "registryVersion": "business-invariant/v1",
        "params": {
          "resourceIdentityField": "sku",
          "baselineRole": "skuBaseline",
          "baselineUnitsField": "initialAvailableUnits",
          "remainingRole": "skuRemaining",
          "remainingUnitsField": "remainingAvailableUnits",
          "consumptionEffectRole": "reservation",
          "consumptionEffectIdentityField": "reservationId",
          "consumptionUnitsField": "reservedUnits",
          "consumptionAcceptedMatch": {
            "field": "status",
            "value": "ACCEPTED"
          },
          "completenessProof": {
            "kind": "observed-total",
            "queryId": "reservationsSummary",
            "subjectField": "sku",
            "totalField": "acceptedReservationTotal"
          },
          "scopeBinding": {
            "fields": ["verificationScopeId"],
            "generationField": "generationId"
          }
        }
      }
    ],
    "runScope": {
      "version": "run-scope/v1",
      "setupStep": "establish-scenario",
      "declaredScope": "checkout-zero-response-loss",
      "scopeField": "verificationScopeId",
      "generationField": "generationId",
      "subjects": {
        "INV-CHK-1": ["CHK-RL-001"],
        "INV-INV-1": ["SKU-001"]
      }
    }
  },
  "expectations": {
    "invariantVerdicts": {
      "INV-CHK-1": "PASS",
      "INV-INV-1": "PASS"
    }
  }
}
